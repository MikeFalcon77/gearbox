# Copy to `.env` at the repo root and fill in. Loaded by `npm run start:browser`
# (ide/scripts/start-studio.mjs); nothing else reads it, and a variable already
# exported in the shell always wins over the file.
#
# `.env` is gitignored on purpose -- see the comment at .gitignore:88.

# The key the AI chat answers with. Optional: resolving, generating and every
# diagnostic work without it, and the chat says so rather than failing when it
# is unset.
#
# The other way in is Studio's own setting, `gearbox.ai.apiKey` (Gearbox:
# Settings), which is stored in `~/.theia/settings.json` and takes precedence
# over this variable. Clearing that setting falls back to here.
ANTHROPIC_API_KEY=

# Point the Anthropic SDK at a gateway instead of api.anthropic.com. Read by the
# SDK itself, so it also redirects the connectivity check.
# ANTHROPIC_BASE_URL=

# An extra root certificate to trust *in addition to* Node's bundled roots --
# the right variable behind a TLS-intercepting proxy. Do not use SSL_CERT_FILE
# for a single corporate root: on Node >= 22 it replaces the whole store, and
# public hosts then fail to verify.
# NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem
