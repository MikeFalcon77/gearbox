apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "<< name >>.fullname" . }}
  labels:
    {{- include "<< name >>.labels" . | nindent 4 }}
spec:
  replicas: {{ .Values.replicaCount }}
  selector:
    matchLabels:
      {{- include "<< name >>.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      labels:
        {{- include "<< name >>.selectorLabels" . | nindent 8 }}
      annotations:
        checksum/config: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
    spec:
      serviceAccountName: {{ include "<< name >>.serviceAccountName" . }}
      securityContext:
        {{- include "<< name >>.podSecurityContext" . | nindent 8 }}
      containers:
        - name: << process >>
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          args:
            - --config
            - /etc/gearbox/<< config_filename >>
          securityContext:
            {{- include "<< name >>.containerSecurityContext" . | nindent 12 }}
          ports:
<% for port in container_ports %>
            - name: << port.name >>
              containerPort: << port.port >>
              protocol: TCP
<% endfor %>
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          livenessProbe:
            httpGet:
              path: << liveness_path >>
              port: << http_port >>
          readinessProbe:
            httpGet:
              path: << readiness_path >>
              port: << http_port >>
          volumeMounts:
            - name: config
              mountPath: /etc/gearbox/<< config_filename >>
              subPath: << config_filename >>
              readOnly: true
            - name: home
              mountPath: << home_dir >>
      volumes:
        - name: config
          configMap:
            name: {{ include "<< name >>.fullname" . }}-config
        - name: home
          emptyDir: {}
