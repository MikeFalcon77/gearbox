apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "<< name >>.fullname" . }}-config
  labels:
    {{- include "<< name >>.labels" . | nindent 4 }}
  {{- with (include "<< name >>.annotations" . | trim) }}
  annotations:
    {{- . | nindent 4 }}
  {{- end }}
data:
  << config_filename >>: |
{{ .Files.Get "files/<< config_filename >>" | indent 4 }}
